# Convex deployment URL (written by `npx convex dev` into .env.local)
# Used by the Vite frontend (VITE_CONVEX_URL) and the seed script (CONVEX_URL).
VITE_CONVEX_URL=http://127.0.0.1:3210
CONVEX_URL=http://127.0.0.1:3210

# HTTP actions site URL from Convex (tracking pixel + click redirects)
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211

# Cloud agents only — isolates Convex from your personal deployment
# CONVEX_AGENT_MODE=anonymous

# --- Set these on the Convex deployment (`npx convex env set …`), not in Vite ---
# ADMIN_SECRET=long-random-string
# RESEND_API_KEY=re_…          # omit for dry-run sends (status still becomes "sent")
# EMAIL_FROM=Cursor Codechella <noreply@cursorvictoria.com>
# CONVEX_SITE_URL=http://127.0.0.1:3211   # or your deployment .convex.site URL
# SITE_URL=http://127.0.0.1:3211          # optional fallback for tracking base
